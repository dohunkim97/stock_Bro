// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StockMaster {
  id         String    @id @default(cuid())
  name       String    @unique
  code       String    @unique
  market     String
  sector     String
  price      String
  changePct  Float
  marketCap  String?
  per        String?
  pbr        String?
  roe        String?
  debtRatio  String?
  revenue    String?
  industry   String?
  quoteDate  String?
  updatedAt  DateTime  @updatedAt
}

model DailyEntry {
  id        String   @id @default(cuid())
  date      String
  listType  String
  rank      Int
  name      String
  code      String?
  sector    String
  market    String?
  price     String
  changePct Float
  volume    String?
  tradingValue  String?
  marketCap     String?
  per           String?
  pbr           String?
  roe           String?
  debtRatio     String?
  reserveRatio  String?
  industry      String?
  revenue       String?
  issue         String?
  createdAt DateTime @default(now())

  @@index([date, listType])
}

model Watchlist {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  market    String?
  sector    String?
  createdAt DateTime @default(now())
}

// Single-row cache for the KIS OAuth token — serverless functions don't
// share memory between invocations, and KIS rate-limits how often a fresh
// token can be issued, so this needs to live somewhere durable.
model KisToken {
  id          String   @id @default("singleton")
  accessToken String
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
}

// One AI-generated read on the market per (date, slot) — three a day now
// (morning/midday/close, see lib/market-briefing.ts). (date, slot) is
// unique so a retried cron run for a slot that already ran just overwrites
// that slot rather than piling up duplicates, but different slots on the
// same day — and every previous day — stay around to browse, not just the
// latest one.
model MarketBriefing {
  id         String   @id @default(cuid())
  date       String
  slot       String   @default("close")
  summary    String
  sectorNote String?
  candidates String?
  createdAt  DateTime @default(now())

  @@unique([date, slot])
}

// A finer-grained investment theme for a stock (e.g. "태양광", "2차전지"),
// extracted from Telegram article headlines — see lib/theme-extraction.ts.
// Overrides the broad KIS 업종 classification (e.g. "건설") wherever that
// stock shows up, since KIS itself has no theme-level category. Keyed by
// company name (not code) since extraction only ever sees a name in text.
// code is backfilled after the fact (lib/theme-daily-flow.ts resolves it via
// resolveStock) since LLM extraction and ETF holdings sources populate it
// differently — ETF sync knows the code immediately, news-based extraction
// doesn't until resolved.
model StockTheme {
  name      String   @id
  theme     String
  code      String?
  source    String?
  updatedAt DateTime @updatedAt
}

// One row per (day, themed stock)'s actual trading value — independent of
// whether that stock happened to rank in that day's gainer/loser/volume TOP
// lists. lib/money-flow.ts used to derive "테마별 거래대금" only from stocks
// that showed up in DailyEntry (the ranking tables), which meant a themed
// stock quietly falling out of the top rankings on a given day looked
// identical to real money leaving the theme (a hard -100% cliff) — this
// exists so the money-flow panels track real capital flow instead of
// ranking visibility. Synced once per day (lib/sync-runner.ts) via a direct
// per-stock quote lookup for every themed stock, not just ranked ones.
model ThemeDailyFlow {
  id           String   @id @default(cuid())
  date         String
  code         String
  name         String
  theme        String
  tradingValue String
  changePct    Float
  marketCap    String?
  createdAt    DateTime @default(now())

  @@unique([date, code])
}

// 종목별 투자자매매동향(외국인+기관 순매수) rolled up to the theme level — the
// "거래대금이 큰가"(ThemeDailyFlow, 시장 관심/활발함) 와는 다른 질문으로, "사는
// 쪽이 파는 쪽보다 우세한가"를 직접 본다. lib/kis-investor-trend.ts의 종목별
// 순매수 조회를 태깅된 종목 전체에 대해 한 번씩 돌려 저장한다 — 그 endpoint가
// 호출 한 번에 최근 N거래일을 다 주기 때문에 ThemeDailyFlow처럼 날짜별로 따로
// 조회할 필요가 없다.
model ThemeNetFlow {
  id             String   @id @default(cuid())
  date           String
  code           String
  name           String
  theme          String
  foreignNet     Float
  institutionNet Float
  individualNet  Float
  createdAt      DateTime @default(now())

  @@unique([date, code])
}

// A "다음 주 강할 섹터/종목" forecast, generated once a week (Friday close,
// see lib/weekly-prediction.ts) and keyed by the week it's FOR (forWeekKey,
// e.g. "2026-08-3" from lib/week.ts) rather than the week it was made in.
// Scoring isn't a stored field — it's computed on demand once forWeekKey's
// week has actually ended, by comparing sectors/candidates against that
// week's real DailyEntry data. sectors/candidates are JSON text in String
// columns, same pattern as MarketBriefing.
model WeeklyPrediction {
  id         String   @id @default(cuid())
  forWeekKey String   @unique
  summary    String
  sectors    String
  candidates String
  createdAt  DateTime @default(now())
}

// A "지금 자금 흐름을 보면 어디에 선제적으로 관심 가질 만한지" personal take,
// generated once per sync (see lib/money-flow-take.ts) from that day's money
// flow table + rotation data. Keyed by the date it's FOR, one row per day.
model MoneyFlowTake {
  id        String   @id @default(cuid())
  date      String   @unique
  summary   String
  createdAt DateTime @default(now())
}

// Articles forwarded from Telegram into the bot (see app/api/telegram/webhook).
// messageId is unique per chat, not globally — Telegram also retries webhook
// deliveries on timeout, so the composite unique key makes storage idempotent.
model TelegramNews {
  id         String   @id @default(cuid())
  chatId     String
  messageId  Int
  text       String
  link       String?
  sourceName String?
  createdAt  DateTime @default(now())

  @@unique([chatId, messageId])
}
