// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StockMaster {
  id         String    @id @default(cuid())
  name       String    @unique
  code       String    @unique
  market     String
  sector     String
  price      String
  changePct  Float
  marketCap  String?
  per        String?
  pbr        String?
  roe        String?
  debtRatio  String?
  revenue    String?
  industry   String?
  quoteDate  String?
  updatedAt  DateTime  @updatedAt
}

model DailyEntry {
  id        String   @id @default(cuid())
  date      String
  listType  String
  rank      Int
  name      String
  code      String?
  sector    String
  market    String?
  price     String
  changePct Float
  volume    String?
  tradingValue  String?
  marketCap     String?
  per           String?
  pbr           String?
  roe           String?
  debtRatio     String?
  reserveRatio  String?
  industry      String?
  revenue       String?
  issue         String?
  // issue(KIS 뉴스 제목) 그 문구로 네이버 뉴스를 검색해서 가장 관련도 높은
  // 결과 1건의 실제 기사 링크 — KIS 뉴스 API 자체는 제목만 주고 URL을 안
  // 줘서(lib/kis-news.ts) 동기화 시점에 한 번 더 찾아 저장해둔다. 검색이
  // 실패하거나 결과가 없으면 null — 그때는 화면에서 네이버 검색결과
  // 링크로 대신 보낸다(components/market/stock-table.tsx).
  issueUrl      String?
  createdAt DateTime @default(now())

  @@index([date, listType])
}

model Watchlist {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  market    String?
  sector    String?
  createdAt DateTime @default(now())
}

// Single-row cache for the KIS OAuth token — serverless functions don't
// share memory between invocations, and KIS rate-limits how often a fresh
// token can be issued, so this needs to live somewhere durable.
model KisToken {
  id          String   @id @default("singleton")
  accessToken String
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
}

// One AI-generated read on the market per (date, slot) — three a day now
// (morning/midday/close, see lib/market-briefing.ts). (date, slot) is
// unique so a retried cron run for a slot that already ran just overwrites
// that slot rather than piling up duplicates, but different slots on the
// same day — and every previous day — stay around to browse, not just the
// latest one.
model MarketBriefing {
  id         String   @id @default(cuid())
  date       String
  slot       String   @default("close")
  summary    String
  sectorNote String?
  candidates String?
  createdAt  DateTime @default(now())

  @@unique([date, slot])
}

// A finer-grained investment theme for a stock (e.g. "태양광", "2차전지"),
// extracted from Telegram article headlines — see lib/theme-extraction.ts.
// Overrides the broad KIS 업종 classification (e.g. "건설") wherever that
// stock shows up, since KIS itself has no theme-level category. Keyed by
// company name (not code) since extraction only ever sees a name in text.
// code is backfilled after the fact (lib/theme-daily-flow.ts resolves it via
// resolveStock) since LLM extraction and ETF holdings sources populate it
// differently — ETF sync knows the code immediately, news-based extraction
// doesn't until resolved.
model StockTheme {
  name      String   @id
  theme     String
  code      String?
  source    String?
  updatedAt DateTime @updatedAt
}

// One row per (day, themed stock)'s actual trading value — independent of
// whether that stock happened to rank in that day's gainer/loser/volume TOP
// lists. lib/money-flow.ts used to derive "테마별 거래대금" only from stocks
// that showed up in DailyEntry (the ranking tables), which meant a themed
// stock quietly falling out of the top rankings on a given day looked
// identical to real money leaving the theme (a hard -100% cliff) — this
// exists so the money-flow panels track real capital flow instead of
// ranking visibility. Synced once per day (lib/sync-runner.ts) via a direct
// per-stock quote lookup for every themed stock, not just ranked ones.
model ThemeDailyFlow {
  id           String   @id @default(cuid())
  date         String
  code         String
  name         String
  theme        String
  tradingValue String
  changePct    Float
  marketCap    String?
  createdAt    DateTime @default(now())

  @@unique([date, code])
}

// 종목별 투자자매매동향(외국인+기관 순매수) rolled up to the theme level — the
// "거래대금이 큰가"(ThemeDailyFlow, 시장 관심/활발함) 와는 다른 질문으로, "사는
// 쪽이 파는 쪽보다 우세한가"를 직접 본다. lib/kis-investor-trend.ts의 종목별
// 순매수 조회를 태깅된 종목 전체에 대해 한 번씩 돌려 저장한다 — 그 endpoint가
// 호출 한 번에 최근 N거래일을 다 주기 때문에 ThemeDailyFlow처럼 날짜별로 따로
// 조회할 필요가 없다.
model ThemeNetFlow {
  id             String   @id @default(cuid())
  date           String
  code           String
  name           String
  theme          String
  foreignNet     Float
  institutionNet Float
  individualNet  Float
  createdAt      DateTime @default(now())

  @@unique([date, code])
}

// A "지금부터 5거래일" stock-pick forecast, generated fresh every trading day
// (see lib/weekly-prediction.ts) and keyed by the day it's FOR (forDate,
// "YYYY-MM-DD") — one permanent row per calendar day, not upserted across
// days, so every past day's exact call stays browsable in 기록보관소 even
// after later days publish different picks. Model name is legacy (this
// used to be a once-a-week, upserted-in-place forecast keyed by forWeekKey;
// renaming the table felt riskier than living with the old name while
// mid-refactor alongside concurrent work elsewhere in the app).
// Each candidate's tracking window is exactly 5 trading days from forDate's
// close (assumed buy price: that day's 15:30 종가) — see
// lib/candidate-tracking.ts. Scoring isn't a stored field — it's computed
// on demand once forDate + 5 trading days has actually passed, comparing
// candidates against real chart data. sectors/candidates are JSON text in
// String columns, same pattern as MarketBriefing.
model WeeklyPrediction {
  id         String   @id @default(cuid())
  forDate    String   @unique
  summary    String
  sectors    String
  candidates String
  // 종목별 근거(사업요약/시황/거래량/차트/재료/수급/재무/매수타이밍)를 생성
  // 시점에 딱 한 번 계산해서 그대로 굳혀 저장한 JSON(CandidateDetail[]) —
  // 페이지를 새로고침할 때마다 실시간 시세/수급/LLM을 다시 불러서 값이
  // 나타났다 사라졌다 바뀌는 걸 막기 위함. null이면(마이그레이션 이전 옛
  // 레코드) 호출부가 그때만 예전처럼 즉석에서 계산해 보여준다.
  details    String?
  // 추천 후보로 골랐지만 과열 필터(lib/prediction-features.ts noTradeReason)에
  // 걸려 발행에서 뺀 종목과 그 이유 — JSON [{name, code?, reason}]. 억지로
  // 채우지 않고 "왜 추천 안 했는지"도 기록으로 남겨서 화면에 투명하게
  // 보여주기 위함. null이면 그날 제외된 종목이 없었거나 옛 레코드.
  filtered   String?
  createdAt  DateTime @default(now())
}

// 예상종목 한 건의 5거래일 "결과 확정본"(Outcome DB) — 채점을 화면을 열 때마다
// KIS 차트를 다시 받아 계산하는 대신 창이 끝나면 한 번만 계산해서 굳힌다
// (lib/prediction-outcome-store.ts). 목표/손절 중 무엇이 먼저였는지, 최종
// 수익률과 실현수익률은 왜 다른지가 한 행에 다 남는다. features는 추천 시점
// (매수일 종가까지)의 캔들로만 계산한 수치라 사후정보가 섞이지 않는다.
// 조건별 통계(거래량 폭증+수급 같은 조합의 목표도달률)는 이 테이블을 그대로
// 집계하면 된다.
model PredictionOutcome {
  id             String   @id @default(cuid())
  forDate        String
  code           String
  name           String
  entryPrice     Float
  targetPrice    Float?
  stopPrice      Float?
  outcome        String // TARGET | STOP | TIMEOUT | AMBIGUOUS | UNRATED(목표/손절이 저장 안 된 옛 레코드)
  exitDay        Int?
  exitPrice      Float?
  realizedPct    Float? // 청산가 기준 실현 수익률 — 가상 포트폴리오 집계용
  closePct       Float? // 5일차 종가 기준 수익률
  targetTouchDay Int?
  stopTouchDay   Int?
  mfePct         Float?
  maePct         Float?
  features       String // JSON EntryFeatures(추천 시점 수치)
  verdicts       String? // JSON 추천 당시 시황/거래량/차트/재료/수급/재무 O/X(WeeklyPrediction.details에서 복사)
  resolvedAt     DateTime @default(now())

  @@unique([forDate, code])
  @@index([forDate])
}

// A "지금 자금 흐름을 보면 어디에 선제적으로 관심 가질 만한지" personal take,
// generated once per sync (see lib/money-flow-take.ts) from that day's money
// flow table + rotation data. Keyed by the date it's FOR, one row per day.
model MoneyFlowTake {
  id         String   @id @default(cuid())
  date       String   @unique
  summary    String
  candidates String? // JSON-encoded CandidateItem[] (name/code/reasoning) — see lib/money-flow-take.ts
  createdAt  DateTime @default(now())
}

// Golgoo chat turns, persisted so past conversations can be browsed in the
// 기록보관소 archive's 대화기록 tab (see lib/chat-history.ts). Grouped by
// calendar date for that archive, the same way MarketBriefing/
// WeeklyPrediction's own archives already group by day/week — no separate
// "session" concept, just every message stamped with the day it was sent.
// userId는 nullable — 로그인 없이도 /bro에서 채팅이 되니, 그 턴은 누구 것도
// 아닌 채로 남는다(둥지 기록 도구는 로그인했을 때만 켜지니 비로그인 턴에
// 개인 정보가 섞일 일은 없다). 로그인한 사용자끼리는 서로의 대화를 절대
// 섞지 않아야 해서(둘째 사용자 온보딩 계기로 발견: 텔레그램 "오늘의 대화"
// 기억이 userId 없이 날짜만으로 묶여 있었음) 반드시 userId로 가른다.
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  role      String
  text      String
  createdAt DateTime @default(now())

  @@index([date])
  @@index([userId, date])
}

// 텔레그램 webhook 중복 전달(응답이 늦으면 재시도함) 방지 — update_id는 이
// 봇 전체에서 유일/단조증가라, 이미 처리한 update_id면 그대로 재처리(지출/
// 매수 기록이 두 번 쌓이는 것 등)를 막는다. updateId만으로 충분해 다른
// 컬럼은 없다.
model TelegramProcessedUpdate {
  updateId  Int      @id
  createdAt DateTime @default(now())
}

// Articles forwarded from Telegram into the bot (see app/api/telegram/webhook).
// messageId is unique per chat, not globally — Telegram also retries webhook
// deliveries on timeout, so the composite unique key makes storage idempotent.
model TelegramNews {
  id         String   @id @default(cuid())
  chatId     String
  messageId  Int
  text       String
  link       String?
  sourceName String?
  createdAt  DateTime @default(now())

  @@unique([chatId, messageId])
}

// 둥지(My Page) — 개인 포트폴리오. 로그인이 없는 단일 사용자 앱이라 설정은
// 싱글톤 한 행(id="singleton")으로 충분하다. 채권/대체자산/현금은 이 앱에
// 라이브 시세 소스가 없어(KIS는 국내 주식 전용) 종목별로 관리하지 않고
// 총액만 입력받는다 — 실시간 평가금액·자동 손절가·AI 목표가는 주식
// 보유분(PortfolioHolding)에만 적용된다.
// 사용자당 설정 하나(userId가 곧 "싱글톤 키" 역할 — 예전엔 id 자체가
// 고정값 "singleton"이라 전체 사이트에 딱 한 행뿐이었는데, 구글 로그인이
// 생기면서 사용자별로 나눴다). onDelete: Cascade로 User가 지워지면 설정도
// 같이 정리된다.
model PortfolioSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalSeed      Float    @default(0)
  cashAmount     Float    @default(0)
  bondAmount     Float    @default(0)
  altAssetAmount Float    @default(0)
  targetStockPct Float    @default(60)
  targetBondPct  Float    @default(20)
  targetAltPct   Float    @default(10)
  targetCashPct  Float    @default(10)
  updatedAt      DateTime @updatedAt
}

// 보유 주식 한 종목 = 한 행. 같은 종목을 여러 번(분할 매수 등) 추가하면
// 여러 행으로 남아 각자의 매수가를 따로 추적한다 — 평단가로 합치지 않는
// 이유는, 손절가/목표가처럼 이 앱이 계산하는 지표들이 매수 시점의 맥락
// (그때 얼마에 샀는지)에 의미가 있기 때문. userId — PortfolioSettings와
// 같은 이유(구글 로그인 후 사용자별 분리)로 붙었다.
model PortfolioHolding {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  code      String
  buyPrice  Float
  quantity  Float
  buyDate   String? // YYYY-MM-DD — 보유 기간 계산용. 없으면(예전에 등록한 종목) 화면에서 직접 입력
  createdAt DateTime @default(now())

  @@index([userId])
}

// 둥지 리뉴얼(재무관리) — 수입 한 건. category는 자유 텍스트로 두되
// lib/finance-engine.ts에 추천 목록(월급/부업/보너스/기타)을 둔다 — DB
// 레벨에서 enum으로 강제하면 나중에 항목이 늘 때마다 마이그레이션이
// 필요해져서, 다른 카테고리형 필드(테마 등)와 같은 방식으로 자유 텍스트로.
model IncomeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  category  String // 월급/부업/보너스/이자·배당/기타
  amount    Float
  recurring Boolean  @default(false) // 매달 반복되는 수입인지(월급 등) — 소비/저축률 계산에서 참고용
  memo      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// 지출 한 건. category는 GPT 설계의 12개 분류(주거/식비/외식/교통/통신/
// 보험/의료/쇼핑/여가/교육/구독/기타)를 lib/finance-engine.ts에 상수로 둔다.
model ExpenseRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  category  String
  amount    Float
  recurring Boolean  @default(false)
  memo      String?
  // 할부 — 할부는 회차마다 한 행씩 만들어(date=회차별 결제일, amount=그 회차 납부액)
  // 월별 지출 합계가 그대로 맞게 한다. 같은 할부의 행은 groupId로 묶는다.
  installmentGroupId String?
  installmentIndex   Int? // 1부터
  installmentMonths  Int? // 총 개월 수
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([installmentGroupId])
}

// 부채 한 건(대출 등) — 순자산 계산(총자산-총부채)과, 나중에 "고금리
// 부채는 투자보다 상환 우선" 판단(GPT 설계 9번)에 쓴다.
model Liability {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String // 신용대출/전세자금대출/카드론/기타
  principal      Float // 남은 원금
  interestRate   Float // 연 금리(%)
  monthlyPayment Float @default(0)
  maturityDate   String? // YYYY-MM-DD
  createdAt      DateTime @default(now())

  @@index([userId])
}

// 목표(예: "2030년까지 1억원") — 목표 화면(GPT 설계 24번: 월 투자금
// 슬라이더로 예상 달성일이 실시간으로 바뀌는 시뮬레이터)의 기반 데이터.
// 실제 달성일 계산은 저장 안 하고 매번 lib/finance-engine.ts가 그때그때
// 계산한다(월 투자금이나 기대수익률 가정이 바뀔 수 있어서 캐싱 대상이 아님).
model FinancialGoal {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  targetAmount        Float
  targetDate          String // YYYY-MM-DD
  monthlyContribution Float // 현재 월 투자금(목표 달성일 계산의 기본값)
  expectedReturnPct   Float    @default(5) // 연 기대수익률(%)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

// 하루에 한 번(둥지 방문 시 그날 첫 계산에서 upsert)씩 그 시점 순자산을
// 찍어두는 스냅샷 — "내 순자산이 1년 동안 어떻게 변했지?"를 나중에
// 그래프로 보여주려면 시계열이 필요한데, 실시간 계산값만으로는 과거
// 시점을 재현할 수 없어서(주가가 계속 바뀌므로) 반드시 하루 단위로
// 쌓아둬야 한다(GPT 설계 8번, financial_snapshots).
model FinancialSnapshot {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String // YYYY-MM-DD, 하루 1행
  cash           Float
  stockValuation Float
  otherAssets    Float // 채권+대체자산(PortfolioSettings.bondAmount+altAssetAmount)
  totalAssets    Float
  totalDebt      Float
  netWorth       Float
  monthlyIncome  Float // 최근 30일 수입 합
  monthlyExpense Float // 최근 30일 지출 합
  createdAt      DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// A handful of short "이 회사가 실제로 뭘 파는가" keywords per stock (see
// lib/company-keywords.ts), LLM-extracted from real news headlines — not
// from StockMaster.sector/industry, which are broad KRX classifications, not
// product-level. Cached per code and only re-extracted after REFRESH_DAYS so
// 종목상세 doesn't re-run an LLM call on every single page view.
model CompanyKeywords {
  code      String   @id
  keywords  String
  updatedAt DateTime @updatedAt
}

// 기록보관소의 주간분석/월간분석 — 그 기간에 나온 모든 일간 예상종목의
// 5거래일 추적이 전부 끝난 뒤(lib/prediction-scoring.ts의 scorePrediction이
// 전부 non-null을 반환해야) 한 번만 생성된다(lib/period-analysis.ts).
// week/month를 별도 테이블로 나누지 않고 periodType으로 구분하는 이유는
// 두 종류가 스키마·생성 로직이 완전히 동일하고 periodKey 포맷만 다르기
// 때문(주: lib/week.ts의 "YYYY-MM-W", 월: "YYYY-MM"). results는 그 기간
// 모든 후보의 실제 결과(오른 이유/내린 이유 포함) JSON 배열.
model PeriodAnalysis {
  id               String   @id @default(cuid())
  periodType       String // "week" | "month"
  periodKey        String
  label            String // "9월 1주" | "2026년 9월"
  startDate        String
  endDate          String
  summary          String
  candidateHitRate Float?
  results          String // JSON PeriodCandidateResult[]
  // 시황/거래량/차트/재료/수급/재무 6개 항목(O/X)이 실제 수익률과 얼마나
  // 맞아떨어졌는지 항목별 집계 — JSON CategoryStat[]. null이면(마이그레이션
  // 이전 옛 레코드) 화면에서 그 부분만 비워 보여준다.
  categoryStats    String?
  // 위 집계를 근거로 LLM이 뽑은 "다음에 참고할 점" — JSON string[].
  // lib/weekly-prediction.ts가 다음 종목 선정 프롬프트에 그대로 읽어 넣는
  // "자체 학습" 연결 지점(latestWeeklyInsightsBlock).
  insights         String?
  createdAt        DateTime @default(now())

  @@unique([periodType, periodKey])
}

// 사용자가 로컬에서 돌리는 별도 "기업분석" 프로그램의 결과물(DART 공시
// 기반 "족보/펀더멘털" 심층 분석, JSON 파일) — C:\...\다트 데이터\기업분석
// 데이터 폴더를 scripts/watch-company-analysis.ts가 감시하다 파일이
// 생기거나 바뀌면 그 내용 그대로 여기에 올려둔다. rawJson은 그 프로그램이
// 만든 JSON 구조(category_1_company_overview 등)를 그대로 문자열로 보관 —
// 회사마다 sub_* 키 구성이 조금씩 달라서(예: 삼성전자엔 있고 다른 회사엔
// 없는 항목 등) 스키마를 억지로 고정하지 않고 화면(컴포넌트)에서 유연하게
// 읽는다. sourceFile은 재실행 시 같은 파일이 또 처리되는지 확인용.
model CompanyAnalysis {
  code       String   @id
  name       String
  reportName String
  reportUrl  String
  rawJson    String
  sourceFile String
  importedAt DateTime @updatedAt
}

// 장중 실시간 초단기 시그널("햄버거 기법" 기반, lib/intraday-signal.ts) —
// 장 시작 직후 몇 분 안에 "기준 거래대금 돌파(평소 대비 급증) + 양봉"을
// 실시간으로 포착해서 기록한다. 이 앱은 실제 주문을 넣지 않는 리서치/
// 기록 도구라, "그 순간에 매수했다고 가정"하고 그 뒤 가격을 계속 추적해서
// 목표수익 도달(target)/5분선 이탈(ma_break)/장마감 강제청산(eod) 중
// 뭘로 끝났는지 남긴다 — WeeklyPrediction의 5거래일 추적과 같은 철학이지만
// 시간 단위가 초단기(하루 안)라는 점만 다르다.
model IntradaySignal {
  id              String   @id @default(cuid())
  date            String // YYYY-MM-DD
  code            String
  name            String
  theme           String?
  detectedAt      String // HH:MM 포착 시각
  triggerPrice    Float // 포착 시점 체결가(매수 기준가로 취급)
  triggerValue    Float // 포착 캔들 자체의 거래대금(원)
  baselineValue   Float // 비교 기준이 된 '평소'(직전 분봉 평균) 거래대금(원)
  isBullish       Boolean // 양봉 여부
  hasLowerWick    Boolean // 아래꼬리 존재 여부(매수세 강도)
  sectorConfirmed Boolean @default(false) // 같은 테마 종목이 오늘 여럿 동반 포착됐는지
  status          String  @default("open") // "open" | "target" | "ma_break" | "eod"
  exitPrice       Float?
  exitAt          String? // HH:MM
  finalPct        Float? // 포착가 대비 청산가 등락률
  createdAt       DateTime @default(now())

  @@unique([date, code, detectedAt])
  @@index([date])
}

// 구글 로그인(lib/auth.ts, NextAuth) 사용자 — 세션은 JWT 전략이라 NextAuth
// 자체 Account/Session 테이블은 안 쓰고, 로그인마다 이 테이블에 email로
// upsert만 한다(그래서 필요한 컬럼만 딱 이만큼). role은 ADMIN_EMAILS
// 환경변수와 대조해서 로그인 시점에 한 번 정해진다(lib/auth.ts 참고) —
// "둥지"(개인 자산관리) 데이터를 사용자별로 나누는 다음 단계에서 이
// User.id를 PortfolioSettings/PortfolioHolding의 FK로 쓰게 될 예정.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      String   @default("user") // "user" | "admin"
  telegramChatId String? @unique // 골구가 먼저 말 거는 능동적 알림(손절/판정 악화) 수신처. app/api/telegram/webhook이 발견을 돕는다.
  investmentPrinciples String? // 채팅으로 말해준 "나는 이런 원칙으로 투자해" 한 덩어리 텍스트(set_investment_principle 도구) — 쌓지 않고 최신 걸로 교체
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolioSettings PortfolioSettings?
  portfolioHoldings PortfolioHolding[]
  incomeRecords     IncomeRecord[]
  expenseRecords    ExpenseRecord[]
  liabilities       Liability[]
  financialGoals    FinancialGoal[]
  financialSnapshots FinancialSnapshot[]
  portfolioAssessments PortfolioAssessment[]
  portfolioAlertLogs   PortfolioAlertLog[]
  holdingAlertRecords  HoldingAlertRecord[]
  holdingEventLogs     HoldingEventLog[]
  chatMessages         ChatMessage[]
  holdingTheses        HoldingThesis[]
  learningProgress      LearningProgress?
  learningJournalEntries LearningJournalEntry[]
  tradeJournalEntries  TradeJournalEntry[]
  categoryBudgets      CategoryBudget[]
  budgetAlertLogs      BudgetAlertLog[]
}

// 카테고리별 월 예산 한도 — 채팅으로 설정("식비 예산 50만원으로 해줘",
// lib/golgoo-chat.ts의 set_category_budget 도구). 사용자 요청(2026-10-21)
// 3번 "자동 예산 감시 엔진": 지출 기록 직후 이 한도 대비 사용률을 계산해서
// (lib/budget-engine.ts) 넘으면 LLM 없이 미리 정한 문구로 경고한다.
model CategoryBudget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String // EXPENSE_CATEGORIES 중 하나
  monthlyLimit Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, category])
}

// 예산 경고 발송 기록 — 같은 달, 같은 카테고리, 같은 단계(80%/100%)는 한
// 번만 보내게 막는 쿨다운/상태 관리(lib/portfolio-alertLog와 같은 패턴).
model BudgetAlertLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  level     Int // 80 | 100
  month     String // YYYY-MM
  createdAt DateTime @default(now())

  @@unique([userId, category, level, month])
}

// 매매일지 — 채팅으로 "매수했어"/"매도했어"라고 보고하면 한 행씩 쌓인다.
// 매수는 둥지(PortfolioHolding)에 평단가로 합쳐지지만, 그 "매수했다는 사건"
// 자체는 여기 남아야 나중에 "내 매매 리포트"로 묶어 볼 수 있다. 매도는
// costBasis(그 시점 평단가)를 같이 못박아 둬서, 나중에 평단가가 바뀌어도
// (다른 매수 건 추가 등) 이 행의 실현손익은 매도 당시 그대로 남는다.
model TradeJournalEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code           String
  name           String
  action         String // "BUY" | "SELL"
  date           String // YYYY-MM-DD
  quantity       Float
  price          Float // 체결가(매수가/매도가)
  amount         Float // quantity * price
  costBasis      Float? // SELL만: 매도 시점 평단가
  realizedPnl    Float? // SELL만: (price - costBasis) * quantity
  realizedPnlPct Float? // SELL만
  holdingDays    Int? // SELL만: 최초 매수일부터 매도일까지
  memo           String?
  createdAt      DateTime @default(now())

  @@index([userId, date])
}

// "주식 학습 플래닛"(180일 커리큘럼, lib/learning-curriculum.ts) 진행 상태 —
// 사용자당 하나. 텔레그램에서 "학습 시작해줘"로 시작하고, 평일 아침 크론
// (app/api/cron/daily-briefing)이 매일 미션을 보내며 currentDay를 1씩 늘린다.
// paused면 더 안 보낸다("학습 그만할래"). 진도 자체는 180일을 다 채웠는지
// 보여주는 숫자일 뿐이라 별도 "완료" 상태는 안 둔다(currentDay > 180이면 끝).
model LearningProgress {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate         String // YYYY-MM-DD, 학습 시작일
  currentDay        Int      @default(1) // 지금 진행 중인(아직 "학습 완료" 안 한) 일차
  lastPushDate      String? // 마지막으로 그날 자료를 보여준 날짜(같은 날 재요청 시 중복 안내 방지용)
  lastCompletedDate String? // 마지막으로 "학습 완료"로 하루를 끝낸 날짜 — 이게 있어야 currentDay가 올라감(2026-10-19: 자료만 받아도 진도가 올라가던 걸 "완료"라고 말해야만 올라가게 분리)
  streak            Int      @default(0) // 연속으로 일지(record_learning_journal)를 제출한 일수
  paused            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 매일 쓰는 "투자 연구 일지"(record_learning_journal 도구로 채팅 중 기록) —
// 하루 하나. "투자 기록 검토관" 모드가 지난 가설과 실제 결과를 비교할 때
// 이 테이블을 읽는다. 2026-10-19 사용자가 공유한 상세 기획서에 맞춰 7개
// 항목에서 16개 항목(DB 필드로는 15개 — date/day 빼면)으로 확장했다. 전부
// optional — 전부 다 채워야 저장되는 게 아니라 사용자가 말해준 것만 채워서
// 기록한다(기존 방식 그대로).
model LearningJournalEntry {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              String // YYYY-MM-DD
  day               Int // 기록 당시 180일 중 며칠차였는지
  marketRegime      String? // 오늘의 시장 상황 — 상승/하락/횡보/고변동성
  marketCause       String? // 시장을 움직인 핵심 원인
  disclosureNote    String? // 오늘 읽은 중요 공시
  company           String? // 분석한 기업
  companyCode       String?
  businessStructure String? // 기업의 사업 구조
  earningsChange    String? // 최근 실적 변화
  priceMoveReason   String? // 주가가 움직인 이유
  volumeSupplyNote  String? // 거래량과 수급에서 발견한 점
  thesis            String? // 투자 가설
  bullish           String? // 상승 근거
  bearish           String? // 하락 위험
  invalidation      String? // 가설이 틀렸다고 볼 조건
  dataToCheck       String? // 추가로 확인할 데이터
  nextDayCheck      String? // 다음 날 검증할 내용
  learnings         String? // 오늘 새로 배운 것
  createdAt         DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// "왜 이 종목을 샀는지/계속 들고 가는지"와 "어떤 조건이면 그 논리가 깨졌다고
// 볼지" — 채팅으로 말해준 걸 기록해(record_investment_thesis 도구), 보유종목
// 전담 분석("~보유 이유 아직 유효해?")이 지금 신호와 이 논리를 대조한다.
// 종목당 하나(계속 갱신) — 논리가 바뀌면 덮어쓰고, 과거 버전은 안 남긴다
// (Phase 1 범위; 필요해지면 이력 테이블로 분리).
model HoldingThesis {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code         String
  name         String
  reason       String
  invalidation String? // 이 논리가 무효화되는 조건(예: "영업이익률 10% 밑으로 떨어지면")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, code])
}

// 능동적 알림(lib/portfolio-alerts.ts)이 같은 악화를 하루에 여러 번 보내지 않게
// 막는 중복 방지 로그 — 종목 하나의 "오늘, 이 상태로 악화됐다"는 한 번만 보낸다.
// 같은 날 더 나빠지면(예: 축소검토 → 정밀점검) toState가 달라지므로 다시 보낸다.
model PortfolioAlertLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  date      String // YYYY-MM-DD
  toState   String
  createdAt DateTime @default(now())

  @@unique([userId, code, date])
}

// 둥지 텔레그램 알림 1건(종목 하나)의 "보낸 그 시점" 스냅샷 — 사용자 스펙
// (2026-10-27) 12번 알림 기록. 텔레그램 상세 버튼(📊💰📰⚠️📈)은 이 기록으로만
// 그린다: 버튼 누를 때 다시 조회하면 알림 문구와 상세 숫자가 어긋날 수 있고,
// 웹훅에서 KIS·DART를 다시 부르면 느려서. 버튼 콜백은 chat id → User를 다시
// 찾고 그 User의 기록인지 확인한 뒤에만 보여준다(callback_data는 믿지 않음).
// PortfolioAlertLog(하루 중복 방지)는 그대로 두고 별도로 쌓는다.
// *Snapshot/newsEvidence/triggerReasons/actionScenarios/dataQuality는 JSON 문자열
// (PortfolioAssessment.signals와 같은 방식).
model HoldingAlertRecord {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockCode           String
  stockName           String
  alertType           String // worsened | new-risky
  generatedAt         DateTime @default(now())
  marketDataAsOf      String? // 시세 기준 시각(ISO). 실시간 시세 실패 시 일봉 날짜
  portfolioDataAsOf   String // 둥지 보유 데이터(평단·수량)를 읽은 시각(ISO)
  previousSeverity    String?
  currentSeverity     String
  previousRiskScore   Int? // 신호 합계(등급 판정 내부값)
  currentRiskScore    Int
  currentPrice        Float
  previousClose       Float?
  dailyChangePct      Float?
  avgBuyPrice         Float
  holdingQuantity     Float
  unrealizedReturnPct Float?
  portfolioWeight     Float? // 전체 자산(현금·채권 포함) 대비 %
  technicalSnapshot   String
  volumeSnapshot      String
  flowSnapshot        String
  financialSnapshot   String
  sectorSnapshot      String
  newsEvidence        String
  triggerReasons      String
  actionScenarios     String
  portfolioSnapshot   String // 📈 전체 자산 영향 버튼용
  dataQuality         String
  analysisVersion     String
  deliveryStatus      String   @default("pending") // pending | sent | failed

  @@index([userId, generatedAt])
}

// 둥지 알림의 사건(거래정지·공시·20일 최저가 이탈·수급 변화 등, lib/holding-events.ts)
// 중복 방지·해소 기록 + 등급 히스테리시스 대기("grade-pending:" 키). 같은 사건은
// eventKey 하나로 한 번만 보내고, 상태형 사건은 조건이 풀리면 resolvedAt을 찍어 다시
// 생겼을 때만 또 보낸다. sentAt이 비어 있으면 아직 못 보낸 것(보내기 실패·대기 중).
model HoldingEventLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  eventType   String
  eventKey    String
  severity    String // 긴급 | 주의 | 참고 (grade-pending은 대상 등급)
  title       String
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  sentAt      DateTime?
  resolvedAt  DateTime?

  @@unique([userId, eventKey])
  @@index([userId, code])
}

// 둥지 "AI 골구 종목 진단"(lib/holding-assessment.ts)의 하루 한 건 판정 기록 —
// 종목 하나당 하루 한 행(같은 날 다시 계산하면 덮어씀). 나중에 "지난달 골구가 뭐라고
// 했고 실제로 어땠나"를 보여주려면 판단과 그 근거(신호별 점수)를 그때그때 남겨둬야
// 해서 지금부터 쌓는다 — 시간이 지나야만 생기는 데이터라 코드로 앞당길 수 없다.
// signals는 JSON Signal[](신호별 점수/근거), 상태가 바뀐 이유는 인접한 두 날짜의
// signals를 비교해서 화면에서 계산한다.
model PortfolioAssessment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code              String
  name              String
  date              String // YYYY-MM-DD (KST)
  state             String // 유지 | 관찰 | 축소검토 | 정밀점검
  totalScore        Int
  signals           String // JSON Signal[]
  avgBuyPrice       Float
  currentPrice      Float
  changePct         Float?
  weightPct         Float?
  recoveryNeededPct Float?
  createdAt         DateTime @default(now())

  @@unique([userId, code, date])
  @@index([userId, date])
}

// 골구 AI(Claude) 호출 1건당 토큰 사용량 로그 — 사용자 요청(2026-10-21) 6번
// "AI 호출별 토큰·비용·실행 이유를 로그로 남김". User로의 관계는 일부러
// 안 건다(비로그인 웹 채팅도 호출될 수 있어 userId가 없을 수 있고, 이건
// 순수 집계/감사 로그라 User가 지워져도 기록은 남아있는 게 맞다).
model AiCallLog {
  id               String   @id @default(cuid())
  userId           String? // 비로그인 웹 채팅이면 null
  channel          String // "web" | "telegram"
  trigger          String // 이 호출을 일으킨 사용자 메시지 앞부분(실행 이유 추적용)
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([createdAt])
}
