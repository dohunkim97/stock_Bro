// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StockMaster {
  id         String    @id @default(cuid())
  name       String    @unique
  code       String    @unique
  market     String
  sector     String
  price      String
  changePct  Float
  marketCap  String?
  per        String?
  pbr        String?
  roe        String?
  debtRatio  String?
  revenue    String?
  industry   String?
  quoteDate  String?
  updatedAt  DateTime  @updatedAt
}

model DailyEntry {
  id        String   @id @default(cuid())
  date      String
  listType  String
  rank      Int
  name      String
  code      String?
  sector    String
  market    String?
  price     String
  changePct Float
  volume    String?
  tradingValue  String?
  marketCap     String?
  per           String?
  pbr           String?
  roe           String?
  debtRatio     String?
  reserveRatio  String?
  industry      String?
  revenue       String?
  createdAt DateTime @default(now())

  @@index([date, listType])
}

model Watchlist {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  market    String?
  sector    String?
  createdAt DateTime @default(now())
}

// Single-row cache for the KIS OAuth token — serverless functions don't
// share memory between invocations, and KIS rate-limits how often a fresh
// token can be issued, so this needs to live somewhere durable.
model KisToken {
  id          String   @id @default("singleton")
  accessToken String
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
}

// One AI-generated read on the market per trading day (see
// lib/market-briefing.ts, generated by a daily post-close cron). date is
// unique so re-running the cron for a day that already has one just
// overwrites it rather than piling up duplicates.
model MarketBriefing {
  id         String   @id @default(cuid())
  date       String   @unique
  summary    String
  sectorNote String?
  candidates String?
  createdAt  DateTime @default(now())
}

// Articles forwarded from Telegram into the bot (see app/api/telegram/webhook).
// messageId is unique per chat, not globally — Telegram also retries webhook
// deliveries on timeout, so the composite unique key makes storage idempotent.
model TelegramNews {
  id         String   @id @default(cuid())
  chatId     String
  messageId  Int
  text       String
  link       String?
  sourceName String?
  createdAt  DateTime @default(now())

  @@unique([chatId, messageId])
}
